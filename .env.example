# Copy this file to `.env` in the project root and fill in what you need.
# Nothing here is required for the core forecast/chat flow to work --
# these only unlock optional extras.

# --- Kronos model (optional overrides) ---
KRONOS_MODEL_ID=NeoQuasar/Kronos-base
KRONOS_TOKENIZER_ID=NeoQuasar/Kronos-Tokenizer-base
KRONOS_MAX_CONTEXT=512
DEFAULT_LOOKBACK_DAYS=400
DEFAULT_PRED_LEN=30
DEFAULT_SAMPLE_RUNS=1

# --- Optional news sources ---
# yfinance's built-in news feed always runs first and needs NO key at all --
# leave all three below blank and news/sentiment still works out of the box.
# Fill in ONE (not all) of these only if yfinance's feed feels too thin;
# they're tried in this order as a fallback: Finnhub -> NewsAPI.
#   FINNHUB_API_KEY   -> https://finnhub.io/register            (free tier: 60 calls/min)
#   NEWSAPI_API_KEY   -> https://newsapi.org/register            (free tier: 100 calls/day, dev use only)
#   ALPHAVANTAGE_API_KEY -> https://www.alphavantage.co/support/#api-key
#     (reserved for backtesting/data_loaders.py's optional Alpha Vantage price
#     loader, NOT used by the news feed)
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
NEWSAPI_API_KEY=

# --- Market data provider (assistant/providers/) ---
# "yfinance" is the default and needs no key. Set these only if you want
# to swap the primary OHLCV source or add a fallback for resilience --
# see PROVIDERS.md for the full comparison and rationale.
MARKET_DATA_PROVIDER=yfinance
MARKET_DATA_FALLBACK_PROVIDER=
TWELVEDATA_API_KEY=

# --- Prediction cache (assistant/forecast_cache.py) ---
# Avoids re-running Kronos inference for a forecast that was already
# computed from the exact same market data + parameters within this
# window. Safe to leave at the defaults.
FORECAST_CACHE_TTL_SECONDS=900
FORECAST_CACHE_MAX_ENTRIES=256

# --- Optional: AI-polished explanation wording (assistant/llm.py) ---
# assistant/explain.py always produces a complete, correct, rule-based
# explanation with no key needed. If you set this, assistant/llm.py sends
# that same text to Gemini (model gemini-2.5-flash) to smooth the wording
# into more natural prose -- it's told not to change any numbers/facts, and
# any failure (missing package, bad key, network error) silently falls back
# to the original rule-based text. Get a free key at https://aistudio.google.com/apikey
# Also `pip install google-genai` if you haven't already (it's in requirements.txt).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# How long the optional Gemini wording-polish step (above) is allowed to
# block a forecast reply before it's abandoned in favor of the original
# rule-based text. Kept low since this step is purely cosmetic -- it
# should never be the reason a forecast takes noticeably longer.
LLM_POLISH_TIMEOUT_SECONDS=4
# Looser timeout for general_chat(), where the LLM reply IS the content
# being waited for (not an optional polish on top of something already
# usable).
LLM_CHAT_TIMEOUT_SECONDS=15

# --- Discord bot (integrations/discord_bot.py) ---
DISCORD_BOT_TOKEN=

# --- WhatsApp bot via Twilio (integrations/whatsapp_bot.py) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
PUBLIC_BASE_URL=
